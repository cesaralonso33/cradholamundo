# PostgreSQL ya existente en el VPS. No se crea otro contenedor de base de datos.
APP_PORT=55896

# Si PostgreSQL publica el puerto 5432 del VPS:
DATABASE_URL=postgresql://postgres:CAMBIA_ESTA_PASSWORD@host.docker.internal:5432/inventario?schema=public

JWT_SECRET=REEMPLAZAR_por_una_clave_aleatoria_de_32_o_mas_caracteres
ADMIN_PASSWORD=REEMPLAZAR_por_una_password_segura
LOGIN_MAX_FAILURES=4
LOGIN_BLOCK_MINUTES=15
CORS_ORIGIN=http://IP_DEL_VPS:55896
