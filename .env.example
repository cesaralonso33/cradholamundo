DATABASE_URL="postgresql://postgres@localhost:5432/inventario?schema=public"
# Drizzle uses this same PostgreSQL URL; migrations only run with `npm run db:migrate`.
PORT=3000
JWT_SECRET="change-me-in-production"
ADMIN_PASSWORD="admin123"
LOGIN_MAX_FAILURES=4
LOGIN_BLOCK_MINUTES=15
# Orígenes permitidos separados por coma. En producción usa el dominio real.
CORS_ORIGIN="http://localhost:55896"
